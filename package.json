{
  "name": "herta",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "dotenv -- pnpm --filter @herta/db generate",
    "db:migrate": "dotenv -- pnpm --filter @herta/db migrate:dev",
    "db:push": "dotenv -- pnpm --filter @herta/db push",
    "db:studio": "dotenv -- pnpm --filter @herta/db studio",
    "db:seed": "dotenv -- pnpm --filter @herta/db seed"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.7.2"
  }
}
