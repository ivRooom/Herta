{
  "name": "herta",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --write 'apps/studio/src/app/api/guilds/[guildId]/plugins/[pluginId]/route.ts' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/groups/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/policies/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/roles/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/access/users/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/audit-logs/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/bot-profile/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/commands/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/daily-content/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/leaderboard/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/moderation/detection-settings/page.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/moderation/layout.tsx' 'apps/studio/src/app/dashboard/guilds/[guildId]/roles/layout.tsx' 'apps/studio/src/components/access-resource-navigation.tsx' 'apps/studio/src/components/granular-policy-editor.tsx' 'apps/studio/src/components/restricted-plugin-config-form.tsx' 'apps/studio/src/lib/studio-page-access.ts' 'apps/studio/src/lib/studio-plugin-permissions.test.ts' 'apps/studio/src/lib/studio-policy-resources.test.ts' 'apps/studio/src/lib/studio-policy-resources.ts' >/dev/null && git diff -- . ':(exclude)package.json' && exit 1",
    "clean": "turbo run clean",
    "db:generate": "dotenv -- pnpm --filter @herta/db generate",
    "db:migrate": "dotenv -- pnpm --filter @herta/db migrate:dev",
    "db:migrate:deploy": "dotenv -- pnpm --filter @herta/db migrate:deploy",
    "db:push": "dotenv -- pnpm --filter @herta/db push",
    "db:studio": "dotenv -- pnpm --filter @herta/db studio",
    "db:seed": "dotenv -- pnpm --filter @herta/db seed"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "fast-uri": "4.1.2",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "nanoid": "3.3.18",
      "next": "15.5.21",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "undici": "6.27.0",
      "qs": "6.15.2"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^5.7.2"
  }
}
