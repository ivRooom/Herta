{
  "name": "herta",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "dotenv -- pnpm --filter @herta/db generate",
    "db:migrate": "dotenv -- pnpm --filter @herta/db migrate:dev",
    "db:migrate:deploy": "dotenv -- pnpm --filter @herta/db migrate:deploy",
    "db:push": "dotenv -- pnpm --filter @herta/db push",
    "db:studio": "dotenv -- pnpm --filter @herta/db studio",
    "db:seed": "dotenv -- pnpm --filter @herta/db seed"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "4.1.2",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "nanoid": "3.3.18",
      "next": "15.5.21",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "undici": "6.27.0",
      "qs": "6.15.2"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^5.7.2"
  }
}
