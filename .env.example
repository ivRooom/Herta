# ============================================================
# Herta. — 環境変数テンプレート
# .env にコピーして値を設定してください
#   cp .env.example .env
# ============================================================

# --- 共通 ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/herta

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) で
# OAuth2 アプリを作成し、以下を設定する。
#   OAuth2 スコープ: identify email guilds
#   Redirect URI (Dashboard ログイン): {NEXTAUTH_URL}/api/auth/callback/discord
#     - 開発: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# LFG Button customIdのHMAC署名鍵。openssl rand -base64 32等で32文字以上を生成する。
# BotとWorkerで必ず同じ値を設定する。
LFG_COMPONENT_SECRET=
# Team Split Button・seed HMAC署名鍵。LFGとは別の32文字以上のランダム値を必須とする。
# Bot・Worker・Studioで必ず同じ値を設定する。
TEAM_SPLIT_SECRET=
# Auto Response / Moderation自動検知を使う場合だけtrue。
# Developer PortalのMessage Content Intentも有効化する。
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false
# Config StudioのDiscord User Pickerでユーザー名・表示名検索を使う場合はtrue必須。
# Moderationブラックリストの再参加時自動BANでも利用する。
# Developer PortalのServer Members Intentも必ず有効化する。
# 本番docker-composeでは既定true。開発環境ではPortal設定後にtrueへ変更する。
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=false
# View Channel + Send Messages + Embed Links + Send Messages in Threads
# + Manage Messages + Moderate Members + Kick Members + Ban Members + Manage Roles
# + Change Nickname。Botプロフィール画面でGuild内Nicknameを変更するためChange Nicknameが必要。
# 既存Guildへ追加権限を反映する場合はStudioのGuild Install導線から再認可する。
DISCORD_BOT_PERMISSIONS=1374725106694
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID_DEV=
# 下記は API 側 (NestJS) の OAuth コールバック。Dashboard の NextAuth とは別。
DISCORD_CALLBACK_URL=http://localhost:3001/api/v1/auth/discord/callback

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# --- Studio (Next.js Dashboard) ---
# NEXTAUTH_URL: Dashboard の公開 URL。Discord Redirect URI のベースにもなる。
# NEXTAUTH_SECRET: セッション JWT の署名鍵。`openssl rand -base64 32` で生成。
STUDIO_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# StudioのServer ComponentからBot内部ヘルスへ接続するURL。ブラウザには公開されない。
BOT_HEALTH_URL=http://127.0.0.1:3002/healthz
# 任意。未設定時はHEALTH_CHECK_TIMEOUT_MSに1000msの余裕を加えた値を使用する。
BOT_HEALTH_REQUEST_TIMEOUT_MS=
# Studio -> BotのGuild内部API（options / members / commands / bot-profile / message-studio等）用。
# 32文字以上のランダム値を生成し、BotとStudioで必ず同じ値を共有する。
# Discord Bot TokenをStudioへ渡さず、内部APIをBearer認証するために使用する。
BOT_INTERNAL_API_SECRET=dev-bot-internal-api-secret-change-me-32

# --- Runtime Secret Encryption ---
# Studio管理コンソールから登録するprovider credential等をAES-256-GCMで暗号化するmaster key。
# OpenAI APIキーそのものではない。`openssl rand -base64 32` で一度生成しserver-sideだけに保持する。
# この値を失うと保存済みruntime secretを復号できないため、Secret Manager等にも安全にバックアップする。
HERTA_RUNTIME_SECRET_KEY=

# --- Studio Command Palette Semantic Search (任意) ---
# disabled: 外部providerを呼ばず、lexical/intent検索だけを使用する（既定）。
# openai: Studio serverだけからOpenAI Embeddings APIを呼び、semantic scoreを第二signalとして利用する。
# Providerへ送るcorpusは静的navigation metadataだけに限定する。
STUDIO_SEMANTIC_SEARCH_PROVIDER=disabled
# OpenAI APIキーはHerta管理者がStudio Settingsから登録する方式を推奨。
# これは移行・緊急fallback用で、ブラウザへ公開しないこと。
OPENAI_API_KEY=
# 任意。未設定時はtext-embedding-3-small。
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI Foundation v1 ---
# 既定OFF。Gate 0 / Credential Console rollout完了後に明示的に有効化する。
HERTA_AI_ENABLED=false
# 緊急停止。trueならGuild設定に関係なくproviderを呼ばない。
HERTA_AI_KILL_SWITCH=false
HERTA_AI_PROVIDER=openai
# quality=Sol / balanced=Terra / economy=Luna。clientから任意model指定は受け付けない。
HERTA_AI_MODEL_PROFILE=balanced
HERTA_AI_MAX_INPUT_CHARS=8000
HERTA_AI_MAX_INPUT_BYTES=24000
HERTA_AI_MAX_OUTPUT_TOKENS=800
HERTA_AI_MAX_OUTPUT_CHARS=6000
HERTA_AI_TIMEOUT_MS=12000
HERTA_AI_PROVIDER_RESPONSE_MAX_BYTES=524288
HERTA_AI_USER_RATE_LIMIT=6
HERTA_AI_GUILD_RATE_LIMIT=30
HERTA_AI_RATE_WINDOW_MS=60000
# micro USD。既定はGuildあたり24hで$1、1 request $0.03。
HERTA_AI_GUILD_QUOTA_MICRO_USD=1000000
HERTA_AI_QUOTA_WINDOW_MS=86400000
HERTA_AI_GLOBAL_CONCURRENCY=4
HERTA_AI_PER_REQUEST_COST_LIMIT_MICRO_USD=30000

# --- JWT ---
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Internal (Bot ↔ API 内部通信) ---
INTERNAL_JWT_SECRET=dev-internal-secret-change-in-production

# --- Herta Bot Health ---
# ローカルではStudioの3000番ポートと競合しない3002番を使用する。
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3002
HEALTH_CHECK_TIMEOUT_MS=3000
HEALTH_CACHE_TTL_MS=5000
HEALTH_HEARTBEAT_STALE_MS=120000
# 任意。未設定時はBot packageの現行バージョンを返す。
HERTA_VERSION=0.1.0

# --- Worker ---
# LFGの期限切れ・削除メッセージ復旧走査。既定30秒、10〜300秒。
LFG_SCAN_INTERVAL_SECONDS=30
# Team Splitの期限切れ・表示同期・削除メッセージ復旧。既定30秒、10〜300秒。
TEAM_SPLIT_SCAN_INTERVAL_SECONDS=30

# --- Logging ---
BOT_LOG_LEVEL=debug
WORKER_LOG_LEVEL=debug


# --- Spotify (任意: PresenceのListening検索) ---
# Spotify Developer Dashboardでアプリを作成し、Studioサーバーだけに設定する。
# 未設定でも手動Presenceは利用可能。Client Secretをブラウザへ公開しないこと。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube (任意: PresenceのWatching検索) ---
# Google CloudでYouTube Data API v3を有効化し、APIキーをStudioサーバーだけに設定する。
# 未設定でも手動Presenceは利用可能。APIキーをブラウザへ公開しないこと。
# 本番ではAPIキーにYouTube Data API v3のみのAPI制限を設定することを推奨。
YOUTUBE_API_KEY=
