# ============================================================
# Herta. — 環境変数テンプレート
# .env にコピーして値を設定してください
#   cp .env.example .env
# ============================================================

# --- 共通 ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/herta

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) で
# OAuth2 アプリを作成し、以下を設定する。
#   OAuth2 スコープ: identify email guilds
#   Redirect URI (Dashboard ログイン): {NEXTAUTH_URL}/api/auth/callback/discord
#     - 開発: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# StudioのGuild Install導線で要求するBot権限bitfield。既定はSend Messagesのみ。
DISCORD_BOT_PERMISSIONS=2048
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID_DEV=
# 下記は API 側 (NestJS) の OAuth コールバック。Dashboard の NextAuth とは別。
DISCORD_CALLBACK_URL=http://localhost:3001/api/v1/auth/discord/callback

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# --- Studio (Next.js Dashboard) ---
# NEXTAUTH_URL: Dashboard の公開 URL。Discord Redirect URI のベースにもなる。
# NEXTAUTH_SECRET: セッション JWT の署名鍵。`openssl rand -base64 32` で生成。
STUDIO_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- JWT ---
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Internal (Bot ↔ API 内部通信) ---
INTERNAL_JWT_SECRET=dev-internal-secret-change-in-production

# --- Logging ---
BOT_LOG_LEVEL=debug
WORKER_LOG_LEVEL=debug
