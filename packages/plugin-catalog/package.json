{
  "name": "@herta/plugin-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./quote-runtime": {
      "types": "./src/quote-runtime.ts",
      "default": "./dist/quote-runtime.js"
    },
    "./quote-service": {
      "types": "./src/quote-service.ts",
      "default": "./dist/quote-service.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@herta/db": "workspace:*",
    "@herta/plugin-auto-response": "workspace:*",
    "@herta/plugin-daily-content": "workspace:*",
    "@herta/plugin-lfg": "workspace:*",
    "@herta/plugin-moderation": "workspace:*",
    "@herta/plugin-quote": "workspace:*",
    "@herta/plugin-team-split": "workspace:*",
    "@herta/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
