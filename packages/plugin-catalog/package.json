{
  "name": "@herta/plugin-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./moderation-runtime": {
      "types": "./src/moderation-runtime.ts",
      "default": "./dist/moderation-runtime.js"
    },
    "./moderation-service": {
      "types": "./src/moderation-service.ts",
      "default": "./dist/moderation-service.js"
    },
    "./quote-runtime": {
      "types": "./src/quote-runtime.ts",
      "default": "./dist/quote-runtime.js"
    },
    "./quote-service": {
      "types": "./src/quote-service.ts",
      "default": "./dist/quote-service.js"
    },
    "./auto-response-runtime": {
      "types": "./src/auto-response-runtime.ts",
      "default": "./dist/auto-response-runtime.js"
    },
    "./auto-response-service": {
      "types": "./src/auto-response-service.ts",
      "default": "./dist/auto-response-service.js"
    },
    "./daily-content-runtime": {
      "types": "./src/daily-content-runtime.ts",
      "default": "./dist/daily-content-runtime.js"
    },
    "./daily-content-service": {
      "types": "./src/daily-content-service.ts",
      "default": "./dist/daily-content-service.js"
    },
    "./lfg-runtime": {
      "types": "./src/lfg-runtime.ts",
      "default": "./dist/lfg-runtime.js"
    },
    "./lfg-service": {
      "types": "./src/lfg-service.ts",
      "default": "./dist/lfg-service.js"
    },
    "./team-split-runtime": {
      "types": "./src/team-split-runtime.ts",
      "default": "./dist/team-split-runtime.js"
    },
    "./team-split-service": {
      "types": "./src/team-split-service.ts",
      "default": "./dist/team-split-service.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@herta/db": "workspace:*",
    "@herta/plugin-auto-response": "workspace:*",
    "@herta/plugin-daily-content": "workspace:*",
    "@herta/plugin-lfg": "workspace:*",
    "@herta/plugin-moderation": "workspace:*",
    "@herta/plugin-quote": "workspace:*",
    "@herta/plugin-team-split": "workspace:*",
    "@herta/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
