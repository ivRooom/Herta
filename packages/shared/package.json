{
  "name": "@herta/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./activity-rules": {
      "types": "./src/activity-rules.ts",
      "default": "./dist/activity-rules.js"
    },
    "./plugin-runtime-events": {
      "types": "./src/plugin-runtime-events.ts",
      "default": "./dist/plugin-runtime-events.js"
    },
    "./mbti-core": {
      "types": "./src/mbti-core.ts",
      "default": "./dist/mbti-core.js"
    },
    "./mbti-ivrm-sync": {
      "types": "./src/mbti-ivrm-sync.ts",
      "default": "./dist/mbti-ivrm-sync.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@herta/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
