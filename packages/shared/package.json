{
  "name": "@herta/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./activity-rules": {
      "types": "./src/activity-rules.ts",
      "default": "./dist/activity-rules.js"
    },
    "./plugin-runtime-events": {
      "types": "./src/plugin-runtime-events.ts",
      "default": "./dist/plugin-runtime-events.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2"
  }
}
