generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core テーブル
// ============================================================

model Guild {
  id        String   @id
  name      String
  icon      String?
  ownerId   String?  @map("owner_id")
  plan      String   @default("free")
  locale    String   @default("ja")
  timezone  String   @default("Asia/Tokyo")
  features  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings               GuildSettings?
  birthdayCardBackground BirthdayCardBackground?
  birthdayCardAssets     BirthdayCardAsset[]
  members                GuildMember[]
  roles                  Role[]
  auditLogs              AuditLog[]
  guildPlugins           GuildPlugin[]
  rules                  Rule[]
  moderationDetections   ModerationDetectionEvent[]

  @@map("guilds")
}

model GuildSettings {
  guildId      String   @id @map("guild_id")
  prefix       String   @default("!")
  logChannelId String?  @map("log_channel_id")
  modRoleIds   String[] @map("mod_role_ids")
  adminRoleIds String[] @map("admin_role_ids")
  locale       String   @default("ja")
  settingsJson Json     @default("{}") @map("settings_json")
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_settings")
}

model BirthdayCardBackground {
  guildId     String   @id @map("guild_id")
  contentType String   @map("content_type") @db.VarChar(32)
  fileName    String   @map("file_name") @db.VarChar(120)
  content     Bytes
  sizeBytes   Int      @map("size_bytes")
  width       Int
  height      Int
  sha256      String   @db.Char(64)
  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // content-type / bytes / dimensions / SHA-256 constraints are enforced by migration SQL.
  @@map("birthday_card_backgrounds")
}

model BirthdayCardAsset {
  id          String   @id
  guildId     String   @map("guild_id")
  name        String   @db.VarChar(120)
  contentType String   @map("content_type") @db.VarChar(32)
  content     Bytes
  sizeBytes   Int      @map("size_bytes")
  width       Int
  height      Int
  sha256      String   @db.Char(64)
  isPreset    Boolean  @default(false) @map("is_preset")
  createdBy   String   @map("created_by")
  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Content, dimensions, and SHA-256 CHECK constraints are enforced by migration SQL.
  @@index([guildId, isPreset(sort: Desc), updatedAt(sort: Desc)], map: "birthday_card_assets_guild_preset_updated_idx")
  @@index([guildId, sha256], map: "birthday_card_assets_guild_sha256_idx")
  @@map("birthday_card_assets")
}

model User {
  id            String   @id
  username      String
  discriminator String?
  avatar        String?
  email         String?
  locale        String?
  isAdmin       Boolean  @default(false) @map("is_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships      GuildMember[]
  studioPreference StudioUserPreference?

  @@map("users")
}

model GuildMember {
  guildId  String    @map("guild_id")
  userId   String    @map("user_id")
  nickname String?
  joinedAt DateTime? @map("joined_at")
  roles    String[]

  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@id([guildId, userId])
  @@map("guild_members")
}

model Role {
  id          String   @id @default(uuid())
  guildId     String   @map("guild_id")
  name        String
  permissions String[]
  isDefault   Boolean  @default(false) @map("is_default")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  guildId    String   @map("guild_id")
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  member GuildMember @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  role   Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(uuid())
  guildId    String   @map("guild_id")
  actorId    String   @map("actor_id")
  actorType  String   @default("user") @map("actor_type")
  event      String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  changes    Json?
  metadata   Json?
  severity   String   @default("info")
  ipAddress  String?  @map("ip_address")
  sessionId  String?  @map("session_id")
  createdAt  DateTime @default(now()) @map("created_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, event])
  @@index([guildId, actorId])
  @@index([guildId, targetType, targetId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_guild_target_created_id_idx")
  @@map("audit_logs")
}

model CommandExecutionEvent {
  id          String   @id
  guildId     String?  @map("guild_id")
  commandName String   @map("command_name")
  status      String
  durationMs  Int      @map("duration_ms")
  errorName   String?  @map("error_name")
  executedAt  DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  @@index([executedAt(sort: Desc)])
  @@index([commandName, executedAt(sort: Desc)])
  @@index([guildId, executedAt(sort: Desc)])
  @@map("command_execution_events")
}

// ============================================================
// Plugin System
// ============================================================

model Plugin {
  id          String   @id
  name        String
  description String?
  version     String
  author      String?
  category    String?
  isOfficial  Boolean  @default(false) @map("is_official")
  manifest    Json
  createdAt   DateTime @default(now()) @map("created_at")

  guildPlugins GuildPlugin[]

  @@map("plugins")
}

model GuildPlugin {
  guildId       String   @map("guild_id")
  pluginId      String   @map("plugin_id")
  enabled       Boolean  @default(true)
  config        Json     @default("{}")
  configVersion Int      @default(1) @map("config_version")
  installedAt   DateTime @default(now()) @map("installed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  guild         Guild                      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plugin        Plugin                     @relation(fields: [pluginId], references: [id])
  configHistory GuildPluginConfigHistory[]

  @@id([guildId, pluginId])
  @@map("guild_plugins")
}

model GuildPluginConfigHistory {
  id           String   @id @default(uuid())
  guildId      String   @map("guild_id")
  pluginId     String   @map("plugin_id")
  version      Int
  config       Json
  changedBy    String   @map("changed_by")
  changeReason String?  @map("change_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  guildPlugin GuildPlugin @relation(fields: [guildId, pluginId], references: [guildId, pluginId], onDelete: Cascade)

  @@map("guild_plugin_config_history")
}

// ============================================================
// Rule Engine
// ============================================================

model Rule {
  id             String   @id @default(uuid())
  guildId        String   @map("guild_id")
  pluginId       String?  @map("plugin_id")
  name           String
  description    String?
  enabled        Boolean  @default(true)
  priority       Int      @default(0)
  schemaVersion  Int      @default(1) @map("schema_version")
  trigger        Json
  conditions     Json     @default("[]")
  actions        Json     @default("[]")
  cooldownMs     Int      @default(0) @map("cooldown_ms")
  maxExecutions  Int?     @map("max_executions")
  executionCount Int      @default(0) @map("execution_count")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  executionLogs RuleExecutionLog[]

  @@index([guildId, enabled])
  @@map("rules")
}

model RuleExecutionLog {
  id            String   @id @default(uuid())
  ruleId        String   @map("rule_id")
  guildId       String   @map("guild_id")
  triggerEvent  Json     @map("trigger_event")
  conditionsMet Boolean  @map("conditions_met")
  actionsResult Json?    @map("actions_result")
  error         String?
  durationMs    Int?     @map("duration_ms")
  executedAt    DateTime @default(now()) @map("executed_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([guildId, executedAt(sort: Desc)])
  @@map("rule_execution_logs")
}

// ============================================================
// Operations / Observability
// ============================================================

model ServiceHealthSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  serviceId         String   @map("service_id")
  version           String
  status            String
  discordStatus     String   @map("discord_status")
  databaseStatus    String   @map("database_status")
  redisStatus       String   @map("redis_status")
  workerStatus      String   @map("worker_status")
  databaseLatencyMs Int?     @map("database_latency_ms")
  redisLatencyMs    Int?     @map("redis_latency_ms")
  workerLatencyMs   Int?     @map("worker_latency_ms")
  guildCount        Int      @default(0) @map("guild_count")
  uptimeSeconds     Int      @default(0) @map("uptime_seconds")
  checkedAt         DateTime @map("checked_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([serviceId, checkedAt(sort: Desc)])
  @@index([checkedAt(sort: Desc)])
  @@map("service_health_snapshots")
}

// ============================================================
// Community Activity / Leaderboard
// ============================================================

model CommunityActivityDaily {
  guildId      String   @map("guild_id")
  userId       String   @map("user_id")
  activityDate DateTime @map("activity_date") @db.Date
  metric       String   @db.VarChar(32)
  value        BigInt   @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([guildId, userId, activityDate, metric])
  @@index([guildId, metric, activityDate])
  @@index([guildId, userId, activityDate])
  @@map("community_activity_daily")
}

model CommunityVoiceSession {
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([guildId, userId])
  @@index([guildId, startedAt])
  @@map("community_voice_sessions")
}

// ============================================================
// Plugin: Achievements / Badges
// ============================================================

model AchievementUnlock {
  guildId       String   @map("guild_id")
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)

  @@id([guildId, userId, achievementId])
  @@index([guildId, userId, unlockedAt(sort: Desc)])
  @@index([guildId, achievementId, unlockedAt(sort: Desc)])
  @@map("achievement_unlocks")
}

// ============================================================
// Community Profile
// ============================================================

model CommunityProfilePreference {
  guildId                String   @map("guild_id")
  userId                 String   @map("user_id")
  isPublic               Boolean  @default(true) @map("is_public")
  featuredAchievementIds String[] @default([]) @map("featured_achievement_ids")
  titleAchievementId     String?  @map("title_achievement_id")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([guildId, userId])
  @@index([guildId, isPublic])
  @@map("community_profile_preferences")
}

// ============================================================
// Plugin: Community Challenge / Season
// ============================================================

model CommunityChallengeAssignment {
  guildId      String   @map("guild_id")
  periodType   String   @map("period_type") @db.VarChar(16)
  periodKey    String   @map("period_key") @db.VarChar(32)
  challengeIds String[] @map("challenge_ids")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([guildId, periodType, periodKey])
  @@index([guildId, createdAt(sort: Desc)])
  @@map("community_challenge_assignments")
}

model CommunityChallengeCompletion {
  guildId     String   @map("guild_id")
  userId      String   @map("user_id")
  challengeId String   @map("challenge_id") @db.VarChar(96)
  periodType  String   @map("period_type") @db.VarChar(16)
  periodKey   String   @map("period_key") @db.VarChar(32)
  seasonKey   String   @map("season_key") @db.VarChar(32)
  points      Int
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  @@id([guildId, userId, challengeId, periodType, periodKey])
  @@index([guildId, userId, completedAt(sort: Desc)])
  @@index([guildId, seasonKey, points(sort: Desc)])
  @@index([guildId, periodType, periodKey])
  @@map("community_challenge_completions")
}

model CommunitySeasonSnapshot {
  guildId          String   @map("guild_id")
  seasonKey        String   @map("season_key") @db.VarChar(32)
  seasonIndex      Int      @map("season_index")
  startsAt         DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime @map("ends_at") @db.Timestamptz(3)
  participantCount Int      @default(0) @map("participant_count")
  sourceVersion    Int      @default(1) @map("source_version")
  finalizedAt      DateTime @default(now()) @map("finalized_at") @db.Timestamptz(3)

  entries CommunitySeasonSnapshotEntry[]

  @@id([guildId, seasonKey])
  @@index([seasonKey, finalizedAt(sort: Desc)])
  @@map("community_season_snapshots")
}

model CommunitySeasonSnapshotEntry {
  guildId   String  @map("guild_id")
  seasonKey String  @map("season_key") @db.VarChar(32)
  userId    String  @map("user_id")
  rank      Int
  points    Int
  awardTier String? @map("award_tier") @db.VarChar(16)

  snapshot CommunitySeasonSnapshot @relation(fields: [guildId, seasonKey], references: [guildId, seasonKey], onDelete: Cascade)

  @@id([guildId, seasonKey, userId])
  @@unique([guildId, seasonKey, rank])
  @@index([guildId, seasonKey, awardTier, rank])
  @@map("community_season_snapshot_entries")
}

// ============================================================
// Plugin: Auto Response
// ============================================================

model AutoResponse {
  id              String    @id @default(uuid())
  guildId         String    @map("guild_id")
  name            String
  triggerType     String    @map("trigger_type")
  triggerValue    String    @map("trigger_value")
  matchMode       String    @default("partial") @map("match_mode")
  responseType    String    @default("text") @map("response_type")
  responseContent String    @map("response_content")
  channelIds      String[]  @map("channel_ids")
  roleIds         String[]  @map("role_ids")
  cooldownSeconds Int       @default(0) @map("cooldown_seconds")
  priority        Int       @default(0)
  caseSensitive   Boolean   @default(false) @map("case_sensitive")
  responseCount   Int       @default(0) @map("response_count")
  failureCount    Int       @default(0) @map("failure_count")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz(3)
  enabled         Boolean   @default(true)
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  executionEvents AutoResponseExecutionEvent[]

  @@index([guildId, enabled])
  @@index([guildId, priority(sort: Desc), createdAt])
  @@map("auto_responses")
}

model AutoResponseExecutionEvent {
  id         String   @id @default(uuid())
  guildId    String   @map("guild_id")
  ruleId     String   @map("rule_id")
  status     String
  durationMs Int      @map("duration_ms")
  errorName  String?  @map("error_name")
  executedAt DateTime @default(now()) @map("executed_at")

  rule AutoResponse @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([executedAt(sort: Desc)])
  @@index([guildId, executedAt(sort: Desc)])
  @@index([ruleId, executedAt(sort: Desc)])
  @@index([status, executedAt(sort: Desc)])
  @@map("auto_response_execution_events")
}

// ============================================================
// Plugin: Moderation
// ============================================================

model ModAction {
  id          String    @id @default(uuid())
  guildId     String    @map("guild_id")
  targetId    String    @map("target_id")
  moderatorId String    @map("moderator_id")
  actionType  String    @map("action_type")
  reason      String?
  durationMs  BigInt?   @map("duration_ms")
  expiresAt   DateTime? @map("expires_at")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([guildId, targetId])
  @@map("mod_actions")
}

model WordFilter {
  id             String   @id @default(uuid())
  guildId        String   @map("guild_id")
  pattern        String
  patternType    String   @default("exact") @map("pattern_type")
  action         String   @default("delete")
  reason         String?
  caseSensitive  Boolean  @default(false) @map("case_sensitive")
  exemptRoles    String[] @default([]) @map("exempt_roles")
  exemptChannels String[] @default([]) @map("exempt_channels")
  enabled        Boolean  @default(true)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([guildId, enabled])
  @@map("word_filters")
}

model SpamSettings {
  guildId            String  @id @map("guild_id")
  maxMessages        Int     @default(5) @map("max_messages")
  timeWindowMs       Int     @default(5000) @map("time_window_ms")
  maxMentions        Int     @default(10) @map("max_mentions")
  maxLinks           Int     @default(3) @map("max_links")
  duplicateThreshold Int     @default(3) @map("duplicate_threshold")
  action             String  @default("timeout")
  timeoutDurationMs  BigInt  @default(300000) @map("timeout_duration_ms")
  enabled            Boolean @default(true)

  @@map("spam_settings")
}

model ModerationSettings {
  guildId            String   @id @map("guild_id")
  enableWordFilter   Boolean  @default(true) @map("enable_word_filter")
  enableInviteFilter Boolean  @default(false) @map("enable_invite_filter")
  enableSpamFilter   Boolean  @default(true) @map("enable_spam_filter")
  logChannelId       String?  @map("log_channel_id")
  exemptRoles        String[] @map("exempt_roles")
  exemptChannels     String[] @map("exempt_channels")
  allowedInvites     String[] @map("allowed_invites")
  inviteAction       String   @default("delete") @map("invite_action")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("moderation_settings")
}

model ModerationDetectionEvent {
  id             String    @id @default(uuid())
  guildId        String    @map("guild_id")
  messageId      String    @map("message_id")
  channelId      String    @map("channel_id")
  userId         String    @map("user_id")
  detectionKind  String    @map("detection_kind")
  mode           String    @default("observe")
  messageLength  Int       @map("message_length")
  observedCount  Int?      @map("observed_count")
  threshold      Int?
  ruleIndex      Int?      @map("rule_index")
  idempotencyKey String    @unique @map("idempotency_key")
  reviewStatus   String    @default("unreviewed") @map("review_status")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?   @map("review_note")
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, occurredAt(sort: Desc)])
  @@index([guildId, reviewStatus, occurredAt(sort: Desc)])
  @@index([guildId, detectionKind, occurredAt(sort: Desc)])
  @@index([guildId, userId, occurredAt(sort: Desc)])
  @@map("moderation_detection_events")
}

model ModerationBlacklistEntry {
  guildId           String   @map("guild_id")
  userId            String   @map("user_id")
  reason            String?
  originDetectionId String?  @map("origin_detection_id") @db.Uuid
  createdBy         String   @map("created_by")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([guildId, userId])
  @@index([guildId, active, createdAt(sort: Desc)])
  @@index([userId])
  @@map("moderation_blacklist_entries")
}

// ============================================================
// Plugin: Quote
// ============================================================

model Quote {
  id               String   @id @default(uuid())
  guildId          String   @map("guild_id")
  quoteNumber      Int      @map("quote_number")
  quoteText        String   @map("quote_text")
  sourceMessageId  String?  @map("source_message_id")
  sourceChannelId  String?  @map("source_channel_id")
  sourceMessageUrl String?  @map("source_message_url")
  sourceAuthorId   String?  @map("source_author_id")
  sourceAuthorName String?  @map("source_author_name")
  registeredById   String   @map("registered_by_id")
  registeredByName String   @map("registered_by_name")
  tags             String[] @default([])
  status           String   @default("public")
  isNsfw           Boolean  @default(false) @map("is_nsfw")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([guildId, quoteNumber])
  @@index([guildId, status])
  @@map("quotes")
}

// ============================================================
// Plugin: LFG
// ============================================================

model LfgPost {
  id               String    @id @default(uuid())
  guildId          String    @map("guild_id")
  creatorId        String    @map("creator_id")
  channelId        String    @map("channel_id")
  messageId        String?   @map("message_id")
  game             String
  title            String
  description      String    @default("")
  maxPlayers       Int       @default(5) @map("max_players")
  participantCount Int       @default(1) @map("participant_count")
  startTime        DateTime? @map("start_time") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  status           String    @default("open")
  messageState     String    @default("pending") @map("message_state")
  lastErrorName    String?   @map("last_error_name")
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  version          Int      @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants LfgParticipant[]

  @@index([guildId, status])
  @@index([guildId, channelId, status])
  @@index([guildId, creatorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("lfg_posts")
}

model LfgParticipant {
  lfgId     String    @map("lfg_id")
  guildId   String    @map("guild_id")
  userId    String    @map("user_id")
  status    String    @default("joined")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lfgPost LfgPost @relation(fields: [lfgId], references: [id], onDelete: Cascade)

  @@id([lfgId, userId])
  @@index([guildId, status])
  @@map("lfg_participants")
}

// ============================================================
// Plugin: Team Split
// ============================================================

model TeamSplitSession {
  id               String    @id @default(uuid())
  guildId          String    @map("guild_id")
  creatorId        String    @map("creator_id")
  channelId        String    @map("channel_id")
  messageId        String?   @map("message_id")
  title            String    @default("Team Split")
  teamCount        Int       @default(2) @map("team_count")
  mode             String    @default("random")
  maxParticipants  Int       @default(20) @map("max_participants")
  participantCount Int       @default(0) @map("participant_count")
  participants     String[]  @default([])
  teams            Json?
  seedHash         String    @default("") @map("seed_hash")
  generation       Int       @default(0)
  status           String    @default("open")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  splitAt          DateTime? @map("split_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  messageState     String    @default("pending") @map("message_state")
  lastErrorName    String?   @map("last_error_name")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  participantRecords TeamSplitParticipant[]

  @@index([guildId, status])
  @@index([guildId, channelId, status])
  @@index([guildId, creatorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("team_split_sessions")
}

model TeamSplitParticipant {
  sessionId String    @map("session_id")
  guildId   String    @map("guild_id")
  userId    String    @map("user_id")
  score     Int       @default(0)
  status    String    @default("joined")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  session TeamSplitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([guildId, status])
  @@map("team_split_participants")
}

// ============================================================
// Plugin: Daily Content
// ============================================================

model DailyContent {
  id                  String    @id @default(uuid())
  guildId             String    @map("guild_id")
  channelId           String    @map("channel_id")
  title               String    @default("")
  content             String
  scheduleTime        String    @map("schedule_time")
  timezone            String    @default("Asia/Tokyo")
  enabled             Boolean   @default(true)
  recurrenceType      String    @default("daily") @map("recurrence_type") @db.VarChar(16)
  onceAt              DateTime? @map("once_at") @db.Timestamptz(3)
  weekdays            Int[]     @default([])
  messageFormat       String    @default("text") @map("message_format") @db.VarChar(16)
  embedJson           Json?     @map("embed_json")
  publishAnnouncement Boolean   @default(false) @map("publish_announcement")
  nextRunAt           DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastScheduledAt     DateTime? @map("last_scheduled_at") @db.Timestamptz(3)
  lastSentAt          DateTime? @map("last_sent_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  deliveries DailyContentDelivery[]

  @@index([guildId, enabled])
  @@index([enabled, nextRunAt])
  @@index([guildId, recurrenceType, nextRunAt])
  @@map("daily_contents")
}

model DailyContentDelivery {
  id             String    @id @default(uuid())
  dailyContentId String    @map("daily_content_id")
  guildId        String    @map("guild_id")
  idempotencyKey String    @unique @map("idempotency_key")
  origin         String    @default("scheduled")
  scheduledFor   DateTime  @map("scheduled_for") @db.Timestamptz(3)
  status         String    @default("pending")
  attemptCount   Int       @default(0) @map("attempt_count")
  messageId      String?   @map("message_id")
  errorName      String?   @map("error_name")
  queuedAt       DateTime? @map("queued_at") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  dailyContent DailyContent @relation(fields: [dailyContentId], references: [id], onDelete: Restrict)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([dailyContentId, scheduledFor(sort: Desc)])
  @@map("daily_content_deliveries")
}

// ============================================================
// Plugin: Event / RSVP
// ============================================================

model CommunityEvent {
  id                   String      @id @default(uuid()) @db.Uuid
  guildId              String      @map("guild_id")
  creatorId            String      @map("creator_id")
  channelId            String      @map("channel_id")
  messageId            String?     @map("message_id")
  title                String      @db.VarChar(200)
  description          String?     @db.VarChar(1000)
  location             String?     @db.VarChar(200)
  timezone             String      @default("Asia/Tokyo") @db.VarChar(64)
  startsAt             DateTime    @map("starts_at") @db.Timestamptz(3)
  registrationClosesAt DateTime    @map("registration_closes_at") @db.Timestamptz(3)
  capacity             Int?
  status               String      @default("open") @db.VarChar(16)
  allowMaybe           Boolean     @default(true) @map("allow_maybe")
  allowWaitlist        Boolean     @default(true) @map("allow_waitlist")
  reminderMinutes      Int         @default(60) @map("reminder_minutes")
  reminderSentAt       DateTime?   @map("reminder_sent_at") @db.Timestamptz(3)
  reminderClaimedAt    DateTime?   @map("reminder_claimed_at") @db.Timestamptz(3)
  finalizedAt          DateTime?   @map("finalized_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  rsvps                EventRsvp[]

  @@index([guildId, startsAt])
  @@index([guildId, status, registrationClosesAt])
  @@index([guildId, creatorId, startsAt])
  @@index([guildId, reminderSentAt, startsAt])
  @@map("community_events")
}

model EventRsvp {
  eventId   String         @map("event_id") @db.Uuid
  userId    String         @map("user_id")
  status    String         @db.VarChar(16)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId, status, createdAt])
  @@map("event_rsvps")
}

// ============================================================
// Studio Preferences / Bot Presence
// ============================================================

model StudioUserPreference {
  userId         String   @id @map("user_id")
  defaultGuildId String?  @map("default_guild_id")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("studio_user_preferences")
}

model BotPresenceSetting {
  id           String   @id @default("default")
  status       String   @default("online")
  activityType String   @default("playing") @map("activity_type")
  activityText String   @default("Herta") @map("activity_text")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("bot_presence_settings")
}

model StudioAccessPolicy {
  id          String   @id @db.Uuid
  guildId     String   @map("guild_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  document    Json
  revision    Int      @default(1)
  createdBy   String   @map("created_by")
  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attachments StudioAccessPolicyAttachment[]

  @@unique([guildId, name])
  @@unique([id, guildId])
  @@index([guildId, updatedAt(sort: Desc)])
  @@map("studio_access_policies")
}

model StudioAccessGroup {
  id          String   @id @db.Uuid
  guildId     String   @map("guild_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdBy   String   @map("created_by")
  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members StudioAccessGroupMember[]

  @@unique([guildId, name])
  @@unique([id, guildId])
  @@index([guildId, updatedAt(sort: Desc)])
  @@map("studio_access_groups")
}

model StudioAccessGroupMember {
  groupId   String   @map("group_id") @db.Uuid
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group StudioAccessGroup @relation(fields: [groupId, guildId], references: [id, guildId], onDelete: Cascade, onUpdate: Cascade)

  @@id([groupId, userId])
  @@index([guildId, userId])
  @@map("studio_access_group_members")
}

model StudioAccessPolicyAttachment {
  id            String   @id @db.Uuid
  policyId      String   @map("policy_id") @db.Uuid
  guildId       String   @map("guild_id")
  principalType String   @map("principal_type") @db.VarChar(16)
  principalId   String   @map("principal_id")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy StudioAccessPolicy @relation(fields: [policyId, guildId], references: [id, guildId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([policyId, principalType, principalId])
  @@index([guildId, principalType, principalId])
  @@index([guildId, policyId])
  @@map("studio_access_policy_attachments")
}
