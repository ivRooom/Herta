# ============================================================
# Herta. — 本番環境変数テンプレート
# ------------------------------------------------------------
# Lightsail 上で以下の手順で使用します:
#   cp .env.production.example .env.production
#   vi .env.production   # 実値を設定
#
# ※ .env.production は .gitignore 済み。絶対にコミットしないこと。
# ※ dev-*-change-in-production のデフォルト値は必ず変更すること。
# ============================================================

# --- 共通 ---
NODE_ENV=production

# GitHub Actionsはcommit SHAタグを一時的に上書きしてデプロイする。
# 手動起動時はGHCRへログインした上で、このimageをpullして使用する。
HERTA_IMAGE=ghcr.io/ivrooom/herta:latest
HERTA_VERSION=0.1.0

# --- Database (PostgreSQL) ---
# compose 内の postgres サービスに接続する。
# POSTGRES_PASSWORD と DATABASE_URL のパスワードは必ず一致させること。
POSTGRES_DB=herta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/herta

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Discord ---
# OAuth2 スコープ: identify email guilds
# Redirect URI (Dashboard ログイン): https://herta.ivrm.jp/api/auth/callback/discord
#   ※ Discord Developer Portal の OAuth2 → Redirects に登録すること。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# LFG Button customIdのHMAC署名鍵。BotとWorkerで同じ32文字以上の値を使用する。
# 例: openssl rand -base64 32
LFG_COMPONENT_SECRET=change-me-lfg-component-secret-at-least-32-characters
# Team Split Buttonとseed用HMAC署名鍵。LFGとは別の32文字以上の値を使用する。
# 例: openssl rand -base64 32
TEAM_SPLIT_SECRET=
# Auto Response / Moderation自動検知を本番で使う場合だけtrue。
# Developer Portal側のMessage Content Intent有効化後に切り替える。
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false
# Config Studio User Pickerのユーザー名・表示名検索、および
# Moderationブラックリストの再参加時自動BANで必要。
# Developer Portal側のServer Members Intentも必ず有効化する。
# docker-compose.prod.ymlでは本番標準機能としてtrue固定。
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=true
# View Channel + Send Messages + Embed Links + Send Messages in Threads
# + Manage Messages + Moderate Members + Kick Members + Ban Members + Manage Roles
# + Change Nickname。Botプロフィール画面でGuild内Nicknameを変更するためChange Nicknameが必要。
# 未指定時のdocker-compose.prod.yml fallbackも同じbitfieldを使用する。
# 既存Guildには権限が自動追加されないため、StudioのGuild Install導線から再認可する。
# 緊急AlertでRoleメンションを使う場合、通知用RoleはDiscord側で「このロールにメンションできる」を有効にする。
# HertaへMention Everyone権限は付与せず、明示設定したRoleだけallowedMentionsで許可する。
DISCORD_BOT_PERMISSIONS=1374725106694
DISCORD_PUBLIC_KEY=
# 開発環境だけで使用。本番はBotが参加している全Guildを起動時に同期する。
DISCORD_GUILD_ID_DEV=
# 下記は API 側 (NestJS) の OAuth コールバック。Dashboard の NextAuth とは別。
DISCORD_CALLBACK_URL=https://herta.ivrm.jp/api/v1/auth/discord/callback

# --- API ---
API_PORT=3001
API_URL=https://herta.ivrm.jp
CORS_ORIGINS=https://herta.ivrm.jp
# 本番では原則false。調査時だけ一時的にtrueへ変更し、終了後に必ず戻す。
ENABLE_SWAGGER=false

# --- Studio / Bot internal API ---
# NEXTAUTH_URL: Dashboard の公開 URL。Discord Redirect URI のベースになる。
# NEXTAUTH_SECRET: 必ず `openssl rand -base64 32` で生成した値に変更すること。
STUDIO_PORT=3000
NEXTAUTH_URL=https://herta.ivrm.jp
NEXTAUTH_SECRET=change-me-run-openssl-rand-base64-32
# Docker内部ネットワーク経由でBotの非公開ヘルス/内部APIへ接続する。
# StudioとWorkerの双方が利用する。外部公開URLには設定しないこと。
BOT_HEALTH_URL=http://bot:3000/healthz
# 任意。StudioのBot Health取得で未設定時はHEALTH_CHECK_TIMEOUT_MSに1000msの余裕を加える。
BOT_HEALTH_REQUEST_TIMEOUT_MS=
# Studio / Worker -> Bot内部API用。`openssl rand -base64 32` 等で生成し、Bot/Studio/Workerで共有する。
# Discord Bot TokenをStudioへ渡さず、Botプロフィール更新やDiscord Role操作を行うため必ず変更すること。
BOT_INTERNAL_API_SECRET=change-me-bot-internal-api-secret-at-least-32-characters

# --- Runtime Secret Encryption ---
# Herta Studioの管理コンソールから登録するprovider credentialをAES-256-GCMで暗号化するmaster key。
# OpenAI APIキーそのものではない。一度だけ `openssl rand -base64 32` で生成しserver-sideに保持する。
# この値を失うと保存済みruntime secretを復号できないため、安全なSecret Manager等にもバックアップする。
# 本番では手入力せず、`Deploy Production` workflowがSSM SecureString
# `/ivrm/runtime/herta/runtime-secret-key` から取得して .env.production へ注入する。
# 詳細は docs/RUNTIME_SECRETS.md の "Production Secret Injection" を参照。
HERTA_RUNTIME_SECRET_KEY=

# --- Studio Command Palette Semantic Search (任意) ---
# 既定はdisabled。openaiへ変更した場合だけ、Studio serverからOpenAI Embeddings APIを利用する。
# Providerへ送るcorpusは静的navigation metadataのみで、Guild名/IDやDiscord本文は含めない。
STUDIO_SEMANTIC_SEARCH_PROVIDER=disabled
# OpenAI APIキーはHerta管理者がStudio Settingsから登録する方式を推奨。
# Runtime Secret Storeのread成功かつsecret未登録時だけ使うmigration fallback。Secretのためブラウザへ公開しない。
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI Foundation v1 ---
# 既定OFF。Gate 0 / Credential Console rollout完了後に明示的に有効化する。
HERTA_AI_ENABLED=false
# 緊急停止。trueならGuild設定に関係なくproviderを呼ばない。
HERTA_AI_KILL_SWITCH=false
# Console runtime setting未登録時だけ使うallowlisted non-secret default。
HERTA_AI_PROVIDER=openai
# quality=Sol / balanced=Terra / economy=Luna。clientから任意model指定は受け付けない。
HERTA_AI_MODEL_PROFILE=balanced
# OpenAI Responses API reasoning effort。Console値がある場合はそちらを優先する。
HERTA_AI_REASONING_EFFORT=low
HERTA_AI_MAX_INPUT_CHARS=8000
HERTA_AI_MAX_INPUT_BYTES=24000
HERTA_AI_MAX_OUTPUT_TOKENS=800
HERTA_AI_MAX_OUTPUT_CHARS=6000
HERTA_AI_TIMEOUT_MS=12000
HERTA_AI_PROVIDER_RESPONSE_MAX_BYTES=524288
HERTA_AI_USER_RATE_LIMIT=6
HERTA_AI_GUILD_RATE_LIMIT=30
HERTA_AI_RATE_WINDOW_MS=60000
# micro USD。既定はGuildあたりfixed 24hで$1、1 request $0.12。
HERTA_AI_GUILD_QUOTA_MICRO_USD=1000000
HERTA_AI_QUOTA_WINDOW_MS=86400000
HERTA_AI_GLOBAL_CONCURRENCY=4
HERTA_AI_PER_REQUEST_COST_LIMIT_MICRO_USD=120000

# --- JWT (本番では必ず変更) ---
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Internal (Bot <-> API 内部通信) ---
INTERNAL_JWT_SECRET=change-me-internal-secret

# --- Herta Bot Health ---
HEALTH_ENABLED=true
# Dockerコンテナ内部では全interfaceで待受し、ホスト側を127.0.0.1だけへpublishする。
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000
HEALTH_PUBLISH_HOST=127.0.0.1

# --- Worker ---
# Discord Role作成予約・一時Role削除を走査する間隔。5〜300秒。
DISCORD_ROLE_OPERATION_SCAN_INTERVAL_SECONDS=15
DAILY_CONTENT_SCAN_INTERVAL_SECONDS=30
# LFG期限切れ・表示同期・削除メッセージ復旧。10〜300秒。
LFG_SCAN_INTERVAL_SECONDS=30
# Team Split期限切れ・表示同期・削除メッセージ復旧。10〜300秒。
TEAM_SPLIT_SCAN_INTERVAL_SECONDS=30
WORKER_LOG_LEVEL=info

# --- Spotify (任意: PresenceのListening検索) ---
# Spotify Developer Dashboardでアプリを作成し、Studioサーバーだけに設定する。
# 未設定でも手動Presenceは利用可能。Client Secretをブラウザへ公開しないこと。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
