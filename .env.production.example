# ============================================================
# Herta. — 本番環境変数テンプレート
# ------------------------------------------------------------
# Lightsail 上で以下の手順で使用します:
#   cp .env.production.example .env.production
#   vi .env.production   # 実値を設定
#
# ※ .env.production は .gitignore 済み。絶対にコミットしないこと。
# ※ dev-*-change-in-production のデフォルト値は必ず変更すること。
# ============================================================

# --- 共通 ---
NODE_ENV=production

# GitHub Actionsはcommit SHAタグを一時的に上書きしてデプロイする。
# 手動起動時はGHCRへログインした上で、このimageをpullして使用する。
HERTA_IMAGE=ghcr.io/ivrooom/herta:latest
HERTA_VERSION=0.1.0

# --- Database (PostgreSQL) ---
# compose 内の postgres サービスに接続する。
# POSTGRES_PASSWORD と DATABASE_URL のパスワードは必ず一致させること。
POSTGRES_DB=herta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/herta

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Discord ---
# OAuth2 スコープ: identify email guilds
# Redirect URI (Dashboard ログイン): https://herta.ivrm.jp/api/auth/callback/discord
#   ※ Discord Developer Portal の OAuth2 → Redirects に登録すること。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# StudioのGuild Install導線で要求するBot権限bitfield。既定はSend Messagesのみ。
DISCORD_BOT_PERMISSIONS=2048
DISCORD_PUBLIC_KEY=
# 開発環境だけで使用。本番はBotが参加している全Guildを起動時に同期する。
DISCORD_GUILD_ID_DEV=
# 下記は API 側 (NestJS) の OAuth コールバック。Dashboard の NextAuth とは別。
DISCORD_CALLBACK_URL=https://herta.ivrm.jp/api/v1/auth/discord/callback

# --- API ---
API_PORT=3001
API_URL=https://herta.ivrm.jp
CORS_ORIGINS=https://herta.ivrm.jp
# 本番では原則false。調査時だけ一時的にtrueへ変更し、終了後に必ず戻す。
ENABLE_SWAGGER=false

# --- Studio (Next.js Dashboard) ---
# NEXTAUTH_URL: Dashboard の公開 URL。Discord Redirect URI のベースになる。
# NEXTAUTH_SECRET: 必ず `openssl rand -base64 32` で生成した値に変更すること。
STUDIO_PORT=3000
NEXTAUTH_URL=https://herta.ivrm.jp
NEXTAUTH_SECRET=change-me-run-openssl-rand-base64-32
# Docker内部ネットワーク経由でBotの非公開ヘルスエンドポイントへ接続する。
BOT_HEALTH_URL=http://bot:3000/healthz
# 任意。未設定時はHEALTH_CHECK_TIMEOUT_MSに1000msの余裕を加えた値を使用する。
BOT_HEALTH_REQUEST_TIMEOUT_MS=

# --- JWT (本番では必ず変更) ---
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Internal (Bot <-> API 内部通信) ---
INTERNAL_JWT_SECRET=change-me-internal-secret

# --- Herta Bot Health ---
HEALTH_ENABLED=true
# Dockerコンテナ内部では全interfaceで待受し、ホスト側を127.0.0.1だけへpublishする。
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000
HEALTH_PUBLISH_HOST=127.0.0.1
HEALTH_PUBLISH_PORT=3000
HEALTH_CHECK_TIMEOUT_MS=3000
HEALTH_CACHE_TTL_MS=5000
HEALTH_HEARTBEAT_STALE_MS=120000

# --- Logging ---
BOT_LOG_LEVEL=info
WORKER_LOG_LEVEL=info
