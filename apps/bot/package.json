    "@herta/plugin-sdk": "workspace:*",
    "@herta/plugin-catalog": "workspace:*",
    "@herta/rule-engine": "workspace:*",
    "@herta/db": "workspace:*",
    "@aws-sdk/client-transcribe-streaming": "^3.908.0",
    "@discordjs/voice": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "discord.js": "^14.27.0",
    "ioredis": "^5.4.2",
    "opusscript": "^0.0.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prism-media": "^1.3.5",
    "sharp": "0.35.4",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
