{
  "name": "@herta/plugin-moderation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./dist/service.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@herta/plugin-sdk": "workspace:*",
    "@herta/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
