{
  "contract": {
    "name": "herta-fortune-profile",
    "version": "1.0.0",
    "sourceRepository": "ivRooom/ivrm-contracts",
    "producer": "ivRooom/ivrm-web",
    "consumer": "ivRooom/Herta"
  },
  "method": "POST",
  "path": "/v1/herta/fortune-profile",
  "maxBodyBytes": 1024,
  "maxTimestampSkewMs": 300000,
  "hmacPurpose": "herta-fortune-profile-v1",
  "canonical": "METHOD\nPATH\nTIMESTAMP\nREQUEST_ID\nBODY",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "guildId", "discordUserId"],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "guildId": {
        "type": "string",
        "pattern": "^[0-9]{17,20}$"
      },
      "discordUserId": {
        "type": "string",
        "pattern": "^[0-9]{17,20}$"
      }
    }
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "discordUserId", "profile"],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "discordUserId": {
        "type": "string",
        "pattern": "^[0-9]{17,20}$"
      },
      "profile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["birthday", "mbtiType", "bloodType"],
        "properties": {
          "birthday": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Approved full date of birth, 1900 or later, not future; server-only, never publish."
          },
          "mbtiType": {
            "type": ["string", "null"],
            "pattern": "^[EI][SN][TF][JP]$"
          },
          "bloodType": {
            "enum": ["A", "B", "O", "AB", null],
            "description": "Currently null: ivrm-web has no persisted blood-type field. Never infer."
          }
        }
      }
    }
  }
}
