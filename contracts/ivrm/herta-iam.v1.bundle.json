{
  "bundleVersion": 1,
  "contract": {
    "id": "herta-iam",
    "version": "1.1.0",
    "sourceRepository": "ivRooom/ivrm-contracts"
  },
  "createAccessGroup": {
    "method": "POST",
    "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups",
    "authentication": {
      "type": "http",
      "scheme": "bearer"
    },
    "headers": {
      "actorId": {
        "name": "X-IVRM-Actor-ID",
        "pattern": "^[0-9]{17,20}$",
        "minLength": null,
        "maxLength": null
      },
      "idempotencyKey": {
        "name": "Idempotency-Key",
        "pattern": "^[A-Za-z0-9._:-]{16,128}$",
        "minLength": 16,
        "maxLength": 128
      }
    },
    "request": {
      "contentType": "application/json",
      "maxBytes": 16384,
      "required": ["name"],
      "additionalProperties": true,
      "fields": {
        "name": {
          "type": "string",
          "normalization": "trim",
          "normalizedMinLength": 1,
          "normalizedMaxLength": 100
        },
        "description": {
          "type": ["string", "null"],
          "normalization": "trim-and-empty-to-null",
          "normalizedMaxLength": 500
        }
      }
    },
    "response": {
      "successStatusCodes": [200, 201],
      "errorStatusCodes": [400, 401, 404, 409, 413, 500, 503],
      "replayHeader": {
        "name": "Idempotency-Replayed",
        "value": "true"
      },
      "required": ["status", "replayed", "group"],
      "additionalProperties": false,
      "status": "ok",
      "replayedType": "boolean",
      "group": {
        "required": ["id", "name", "description", "updatedAt"],
        "additionalProperties": false,
        "fields": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "error": {
        "required": ["error"],
        "additionalProperties": false,
        "fields": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "management": {
    "limits": {
      "batchMaxItems": 500,
      "bodyMaxBytes": 16384,
      "membersLimitOptions": [25, 50, 100, 500, 1000],
      "membersLimitDefault": 50,
      "groupMembershipLimit": null
    },
    "capabilities": ["group.delete", "group.member", "group.member.batch", "group.update", "policy.attach", "policy.attach.batch"],
    "operations": {
      "getHertaIamOverview": {
        "method": "GET",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam",
        "capability": "overview",
        "requiredHeaders": [],
        "optionalHeaders": [],
        "queryParameters": [],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [401, 404, 500, 503]
      },
      "updateHertaIamAccessGroup": {
        "method": "PATCH",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups/{groupId}",
        "capability": "group.update",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": 16384,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 409, 413, 429, 500, 503]
      },
      "deleteHertaIamAccessGroup": {
        "method": "DELETE",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups/{groupId}",
        "capability": "group.delete",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [
          {
            "name": "expectedUpdatedAt",
            "required": true
          },
          {
            "name": "cascade",
            "required": false,
            "default": false
          },
          {
            "name": "membersLimit",
            "required": false,
            "default": 50,
            "enum": [25, 50, 100, 500, 1000]
          }
        ],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 409, 413, 429, 500, 503]
      },
      "addHertaIamGroupMember": {
        "method": "PUT",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups/{groupId}/members/{userId}",
        "capability": "group.member",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      },
      "removeHertaIamGroupMember": {
        "method": "DELETE",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups/{groupId}/members/{userId}",
        "capability": "group.member",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      },
      "changeHertaIamGroupMembers": {
        "method": "POST",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/groups/{groupId}/members/batch",
        "capability": "group.member.batch",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": 16384,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      },
      "attachHertaIamPolicy": {
        "method": "PUT",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/policies/{policyId}/attachments/{principalType}/{principalId}",
        "capability": "policy.attach",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      },
      "detachHertaIamPolicy": {
        "method": "DELETE",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/policies/{policyId}/attachments/{principalType}/{principalId}",
        "capability": "policy.attach",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": null,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      },
      "changeHertaIamPolicyAttachments": {
        "method": "POST",
        "pathTemplate": "/api/integrations/ivrm/guilds/{guildId}/iam/policies/{policyId}/attachments/batch",
        "capability": "policy.attach.batch",
        "requiredHeaders": ["X-IVRM-Actor-ID"],
        "optionalHeaders": ["Idempotency-Key"],
        "queryParameters": [],
        "bodyMaxBytes": 16384,
        "successStatusCodes": [200],
        "errorStatusCodes": [400, 401, 404, 413, 429, 500, 503]
      }
    }
  }
}
