# Herta PostgreSQL backup restore verification
# /etc/herta/backup-restore-verification.env へ配置し、chmod 600を設定します。

AWS_REGION=ap-northeast-1
S3_BUCKET=herta-production-backups-ACCOUNT_ID-ap-northeast-1
S3_PREFIX=postgres
SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-1:ACCOUNT_ID:herta-backup-alerts

# 検証用コンテナ
POSTGRES_IMAGE=postgres:16
RESTORE_DATABASE=herta_restore_verify
RESTORE_MEMORY_LIMIT=1g
RESTORE_CPU_LIMIT=1
MIN_PUBLIC_TABLES=1

# 成功時は通知せず、失敗時だけSNS通知する
NOTIFY_SUCCESS=false

# 必要な場合だけ変更する
WORK_ROOT=/var/tmp
LOCK_FILE=/var/tmp/herta-backup-restore-verification.lock
