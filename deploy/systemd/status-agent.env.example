# ============================================================
# Herta. — ivrm-status-agent設定例
# 配置先: /etc/herta/status-agent.env
# 所有者: root:root / mode 0600
# systemdがroot権限で読み込み、非特権serviceへ環境変数として渡す。
# ============================================================

# Lightsailホストへloopback公開されたHerta Bot内部ヘルス
HEALTH_URL=http://127.0.0.1:3000/healthz

# 既存ivrm-stats APIのHerta受信Endpoint。通常運用では変更しない。
STATUS_INGEST_URL=https://stats.ivrm.jp/api/internal/status-ingest

# 必須。空欄のままではAgentが起動しない。
# OCI上のivrm-status-apiへ設定するHERTA_INGEST_SECRETと同じ値を使用する。
# 32文字以上のランダム値を設定し、GitHub・チャット・ログへ出さない。
STATUS_SIGNING_SECRET=

# 既存ivrm-stats側に登録済みのService ID。通常は変更しない。
STATUS_SERVICE_ID=herta-discord-bot

# HTTP接続設定
STATUS_CONNECT_TIMEOUT_SECONDS=5
STATUS_MAX_TIME_SECONDS=15
STATUS_RETRY_COUNT=2
STATUS_MAX_HEALTH_BYTES=65536
STATUS_AGENT_USER_AGENT=ivrm-status-agent/1.1

# 動作確認時だけtrueにする。trueの場合はpayloadを表示してPOSTしない。
STATUS_DRY_RUN=false

# 通常は変更しない。HTTP ingestと非loopback healthはテスト専用。
STATUS_ALLOW_HTTP_FOR_TESTS=false
STATUS_ALLOW_NON_LOOPBACK_HEALTH_URL=false

# 同時実行防止用。PrivateTmp配下で利用する。
STATUS_LOCK_FILE=/var/tmp/herta-status-agent.lock
